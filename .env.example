# Copy to .env for local dev. .env is git-ignored.
#
# The app talks to Gemini through a Cloudflare Worker proxy (papanda-app/gemini-proxy)
# that holds the API key server-side and rate-limits per install. This URL is NOT a
# secret — safe to bundle. Deploy the Worker first (see gemini-proxy/README.md), then
# set this to https://<your-worker>.workers.dev/v1/generate
#
# EAS builds do NOT read this file — add the same var as an EAS environment variable
# for the `preview` and `production` environments.
EXPO_PUBLIC_GEMINI_PROXY_URL=https://papanda-gemini-proxy.example.workers.dev/v1/generate
