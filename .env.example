# Copy to .env for local dev. .env is git-ignored.
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle, so this key ships inside the
# APK and is extractable — treat it as public. In Google AI Studio restrict it to
# the Generative Language API only and set a tight daily quota.
#
# EAS builds do NOT read this file. Add both vars as EAS environment variables
# for the `preview` and `production` environments, or AI features fail silently
# in release builds.
EXPO_PUBLIC_GEMINI_API_KEY=replace_with_a_new_restricted_key

# gemini-3.5-flash-lite has a generous free-tier daily quota. gemini-3.x-flash
# gives better quality but is capped at ~20 requests/day without billing.
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite
